---
import Layout from '../layouts/Layout.astro';
import {
  identity,
  about,
  now,
  story,
  made,
  skills,
  links,
  meta,
} from '../data/resume';

// Content lives in src/data/resume.ts — edit there, not here.

const year = new Date().getFullYear();
const updated = new Date().toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const navItems = [
  { label: 'About', href: '#about' },
  { label: 'Now', href: '#now' },
  { label: 'Story', href: '#story' },
  { label: 'Made', href: '#made' },
];

const pad = (i: number) => String(i + 1).padStart(2, '0');
const external = (href: string) => href.startsWith('http');
---

<Layout>
  <div class="grain vignette linen">
    <!-- ────────────  MASTHEAD BAR  ──────────── -->
    <header
      class="no-print fixed top-0 left-0 right-0 z-50 backdrop-blur-md bg-pine/85 border-b rule"
    >
      <div
        class="mx-auto max-w-6xl px-6 md:px-10 py-3 flex items-center justify-between"
      >
        <a href="#top" class="flex items-center gap-3 text-text">
          <img src="/badge.svg" alt="" class="ivory h-5 w-auto" />
          <span class="label !text-text">{identity.shortName}</span>
        </a>
        <nav class="hidden md:flex items-center gap-8 label" id="site-nav">
          {
            navItems.map((n) => (
              <a href={n.href} class="hover:text-text transition-colors">
                {n.label}
              </a>
            ))
          }
        </nav>
        <a href="#contact" class="label !text-accent-hot hover:!text-text transition-colors">
          Say hi
        </a>
      </div>
    </header>

    <main id="top" class="relative">
      <!-- ────────────  HERO  ──────────── -->
      <section class="relative overflow-hidden border-b rule">
        <div
          class="no-print absolute inset-0"
          style="background:
            radial-gradient(ellipse 60% 60% at 18% 0%, color-mix(in srgb, var(--color-accent) 10%, transparent), transparent 70%);"
        >
        </div>
        <img
          src="/badge.svg"
          alt=""
          aria-hidden="true"
          class="ivory no-print pointer-events-none select-none absolute -right-72 md:-right-40 top-24 w-[46rem] md:w-[58rem] max-w-none opacity-[0.04] rotate-[-7deg]"
        />

        <div class="relative z-10 mx-auto max-w-6xl px-6 md:px-10 pt-28 md:pt-40 pb-20 md:pb-28">
          <div class="flex items-center gap-4 rise delay-1">
            <img src="/badge.svg" alt="33rd Ventures marque" class="ivory h-9 md:h-10 w-auto" />
            <span class="font-display text-[13px] md:text-sm tracking-[0.32em] text-dim">
              {identity.name}
            </span>
          </div>

          <h1
            class="font-serif font-medium text-[clamp(3.2rem,9vw,7rem)] leading-[1] tracking-[-0.01em] mt-10 md:mt-12 rise delay-2"
          >
            Hi, I’m <em class="text-accent-hot">{identity.firstName}</em>.
          </h1>

          <p
            class="font-serif italic text-xl md:text-[1.75rem] leading-[1.5] text-dim max-w-3xl mt-8 md:mt-10 rise delay-3"
          >
            {identity.tagline}
          </p>
        </div>
      </section>

      <!-- ────────────  ABOUT  ──────────── -->
      <section id="about" class="px-6 md:px-10 py-20 md:py-28 scroll-mt-16">
        <div class="mx-auto max-w-6xl grid md:grid-cols-12 gap-6 md:gap-16 reveal">
          <p class="label md:col-span-4 md:pt-2.5">About</p>
          <div class="md:col-span-8 space-y-6">
            {
              about.map((para) => (
                <p class="font-serif text-[clamp(1.2rem,2vw,1.5rem)] leading-[1.65] text-text">
                  {para}
                </p>
              ))
            }
          </div>
        </div>
      </section>

      <!-- ────────────  NOW  ──────────── -->
      <section id="now" class="no-print px-6 md:px-10 py-16 md:py-24 border-t rule scroll-mt-16">
        <div class="mx-auto max-w-6xl grid md:grid-cols-12 gap-8 md:gap-16">
          <div class="md:col-span-4 reveal">
            <p class="label">Now</p>
            <h2 class="font-serif text-[clamp(1.8rem,2.8vw,2.3rem)] leading-tight text-balance mt-3 text-text">
              What I’m working on
            </h2>
            <p class="font-serif italic text-dim mt-3">As of {now.asOf}</p>
          </div>
          <ul class="md:col-span-8 border-t rule">
            {
              now.items.map((item) => (
                <li class="py-6 border-b rule reveal">
                  <h3 class="font-serif font-semibold text-[1.35rem] text-text">{item.title}</h3>
                  <p class="font-serif text-[17px] leading-relaxed text-dim mt-1.5">{item.text}</p>
                  {item.href && (
                    <a
                      href={item.href}
                      {...(external(item.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                      class="inline-block font-serif italic text-[16px] text-accent-hot uline mt-2"
                    >
                      {item.linkLabel} {external(item.href) ? '↗' : '↓'}
                    </a>
                  )}
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- ────────────  STORY  ──────────── -->
      <section
        id="story"
        class="relative overflow-hidden px-6 md:px-10 py-16 md:py-24 border-t rule scroll-mt-16"
      >
        <img
          src="/badge.svg"
          alt=""
          aria-hidden="true"
          class="ivory no-print pointer-events-none select-none absolute -right-48 top-1/2 -translate-y-1/2 w-[54rem] max-w-none opacity-[0.03] rotate-[-8deg]"
        />
        <div class="relative z-10 mx-auto max-w-6xl grid md:grid-cols-12 gap-8 md:gap-16">
          <div class="md:col-span-4 reveal">
            <p class="label">Story</p>
            <h2 class="font-serif text-[clamp(1.8rem,2.8vw,2.3rem)] leading-tight text-balance mt-3 text-text">
              What I’ve done
            </h2>
          </div>
          <ol class="md:col-span-8 border-t rule">
            {
              story.map((s) => (
                <li class="story-row grid sm:grid-cols-[8.5rem_1fr] gap-x-8 gap-y-2 py-7 border-b rule reveal">
                  <p class="label !text-accent-hot lining pt-1.5">{s.dates}</p>
                  <div>
                    <h3 class="font-serif font-semibold text-[1.35rem] leading-tight text-text">
                      {s.href ? (
                        <a href={s.href} target="_blank" rel="noopener noreferrer" class="uline">
                          {s.place}
                        </a>
                      ) : (
                        s.place
                      )}
                      <span class="font-normal italic text-dim text-[17px]"> · {s.role}</span>
                    </h3>
                    <p class="font-serif text-[17px] leading-relaxed text-dim mt-2">{s.text}</p>
                    {s.bullets.length > 0 && (
                      <ul class="print-only mt-2 space-y-1">
                        {s.bullets.map((b) => (
                          <li class="font-serif text-[13px] leading-snug">· {b}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <!-- ────────────  MADE  ──────────── -->
      <section id="made" class="no-print px-6 md:px-10 py-16 md:py-24 border-t rule scroll-mt-16">
        <div class="mx-auto max-w-6xl">
          <div class="reveal">
            <p class="label">Made</p>
            <h2 class="font-serif text-[clamp(1.8rem,2.8vw,2.3rem)] leading-tight text-balance mt-3 text-text">
              Things I’ve made
            </h2>
            <p class="font-serif italic text-dim mt-3 max-w-xl">
              Side businesses, a newsletter, and a few apps I built for myself.
            </p>
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 mt-10 md:mt-12">
            {
              made.map((m, i) => {
                const Tag = m.href ? 'a' : 'div';
                return (
                  <Tag
                    {...(m.href ? { href: m.href, target: '_blank', rel: 'noopener noreferrer' } : {})}
                    class:list={[
                      'made-card club-panel rounded-[4px] p-7 flex flex-col gap-3 reveal',
                      m.href && 'group is-link',
                    ]}
                  >
                    <div class="flex items-center justify-between gap-4">
                      <span class="font-serif italic text-accent-hot lining">{pad(i)}</span>
                      <span class="label">{m.kind}</span>
                    </div>
                    <h3 class="font-serif font-semibold text-[1.35rem] leading-snug text-text mt-1 group-hover:text-accent-hot transition-colors">
                      {m.name}
                      {m.href && <span class="text-accent text-[15px]"> ↗</span>}
                    </h3>
                    <p class="font-serif text-[16px] leading-relaxed text-dim">{m.text}</p>
                  </Tag>
                );
              })
            }
          </div>
        </div>
      </section>

      <!-- Printed résumé only: skills -->
      <section class="print-only px-6">
        <p class="label">Skills</p>
        {
          skills.map((s) => (
            <p class="font-serif text-[13px] mt-1.5">
              <strong>{s.group}:</strong> {s.items.join(' · ')}
            </p>
          ))
        }
      </section>

      <!-- ────────────  CONTACT  ──────────── -->
      <section
        id="contact"
        class="px-6 md:px-10 py-20 md:py-32 border-t rule scroll-mt-16"
      >
        <div class="mx-auto max-w-6xl text-center reveal">
          <img src="/badge.svg" alt="" class="ivory h-10 w-auto mx-auto" />
          <h2 class="font-serif text-[clamp(2.2rem,5vw,3.6rem)] leading-tight mt-8 text-text">
            Say <em class="text-accent-hot">hi</em>.
          </h2>
          <p class="font-serif italic text-lg text-dim mt-4">Hit me up on any of these.</p>
          <div class="rule-double w-28 mx-auto mt-8"></div>

          <div class="flex flex-wrap items-start justify-center gap-x-12 md:gap-x-16 gap-y-8 mt-10">
            {
              links.map((l) => (
                <a
                  href={l.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex flex-col items-center gap-2"
                >
                  <span class="label group-hover:!text-text transition-colors">{l.label}</span>
                  <span class="font-serif text-xl md:text-2xl text-accent-hot">
                    <span class="uline">{l.handle}</span> ↗
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </section>
    </main>

    <!-- ────────────  FOOTER  ──────────── -->
    <footer class="border-t rule">
      <div
        class="mx-auto max-w-6xl px-6 md:px-10 py-10 flex flex-wrap items-center justify-between gap-6 label"
      >
        <span class="flex items-center gap-3">
          <img src="/badge.svg" alt="" class="ivory h-4 w-auto" />
          <span class="lining">33rd Ventures · © {year} · New York City</span>
        </span>
        <span class="no-print hidden md:inline lining">Updated {updated}</span>
        <span class="no-print flex items-center gap-6">
          <button id="print-btn" class="label hover:text-text transition-colors uline cursor-pointer">
            Résumé (PDF)
          </button>
          <a href="#top" class="hover:text-text transition-colors uline">↑ Top</a>
        </span>
      </div>
    </footer>
  </div>

  <script>
    // Scroll-spy: highlights the nav item for the section in view
    const nav = document.getElementById('site-nav');
    if (nav) {
      const navLinks = [...nav.querySelectorAll('a')];
      const sections = navLinks
        .map((a) => document.querySelector(a.getAttribute('href') ?? ''))
        .filter((s): s is Element => s !== null);
      const spy = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            navLinks.forEach((a) =>
              a.setAttribute(
                'aria-current',
                String(a.getAttribute('href') === `#${entry.target.id}`)
              )
            );
          }
        },
        { rootMargin: '-30% 0px -60% 0px' }
      );
      sections.forEach((s) => spy.observe(s));
    }

    document.getElementById('print-btn')?.addEventListener('click', () => window.print());
  </script>
</Layout>
